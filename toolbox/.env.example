# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# Gmail requires an App Password (not the account password), created at
# https://myaccount.google.com/apppasswords with 2FA enabled.

SMTP_USER=convocatorias@fundacionmaradentro.cl
SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Display name on the From: header.
SENDER_NAME=Fundación Mar Adentro

# Signature block. Leave blank to fall back to the institutional defaults in
# lib/mailer.py — set them when a campaign goes out under a person's name.
FIRMA_NOMBRE=
FIRMA_CARGO=
FIRMA_TELEFONO=
FIRMA_DIRECCION=

# Only change for a non-Gmail provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
